
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Admin Portal credentials (required to open the portal at /adm or #adm).
#
# Copy this file to .env and set real values. .env is gitignored, so the
# password stays out of the repository.
#
# WARNING: Vite inlines VITE_* variables into the production bundle at build
# time. This keeps the password out of git, but anyone can still read it from
# the shipped JavaScript. Treat the portal as a convenience gate, not a
# security boundary — move auth server-side before relying on it.
#
# Changing these requires a rebuild AND a STORAGE_KEY bump in
# src/utils/eventStore.ts, or browsers keep using the admin list already saved
# in their localStorage.
# ---------------------------------------------------------------------------
VITE_ADMIN_EMAIL="hello@ekowsamfarms.com"
VITE_ADMIN_PASSWORD="MY_ADMIN_PASSWORD"

# Turnstile site key — public by design, so the VITE_ prefix is correct here.
# Create the widget at dash.cloudflare.com > Turnstile. The matching SECRET key
# goes in the server-side section below, never here.
VITE_TURNSTILE_SITE_KEY="0x4AAAAAAA_MY_SITE_KEY"

# ---------------------------------------------------------------------------
# Server-side admin auth — protects attendee data (GET /api/rsvps).
#
# The VITE_ADMIN_* values above only gate the portal UI; they ship in the JS
# bundle, so they cannot protect anything. These never leave the server and are
# what actually guard the RSVP table. Set them to the SAME email/password so
# there is one credential to remember.
#
# ADMIN_SESSION_SECRET signs session tokens — use a long random string:
#   node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
ADMIN_EMAIL="hello@ekowsamfarms.com"
ADMIN_PASSWORD="MY_ADMIN_PASSWORD"
ADMIN_SESSION_SECRET="MY_LONG_RANDOM_SESSION_SECRET"

# Turnstile SECRET key — pairs with VITE_TURNSTILE_SITE_KEY above.
# Without it /api/rsvp refuses to send anything (fails closed, by design).
TURNSTILE_SECRET_KEY="0x4AAAAAAA_MY_SECRET_KEY"

# ---------------------------------------------------------------------------
# SMTP — outgoing email (RSVP confirmations, admin notifications).
#
# Sent over real SMTP from the Pages Function using `worker-mailer`, which
# speaks SMTP on Cloudflare's TCP socket API. Nodemailer does NOT work on
# Workers — worker-mailer is what makes plain SMTP viable here.
#
# IMPORTANT: deliberately NOT prefixed with VITE_. Vite only inlines VITE_*
# variables into the browser bundle, so leaving the prefix off is what keeps the
# mail password server-side. Never rename these to VITE_SMTP_* — that would
# publish your mail credentials to every visitor.
#
# Port 25 is blocked on Cloudflare. Use 587 (STARTTLS) or 465 (implicit TLS).
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
# "true" for implicit TLS on 465; "false" to connect on 587 and upgrade via STARTTLS.
SMTP_SECURE="false"
SMTP_USER="hello@ekowsamfarms.com"
SMTP_PASSWORD="MY_SMTP_PASSWORD"

# Address attendees see in the From: field
SMTP_FROM="Kosua Ne Meko <hello@ekowsamfarms.com>"
# Optional: organiser address that receives a copy of each RSVP. Blank disables it.
SMTP_NOTIFY_TO="hello@ekowsamfarms.com"

# ---------------------------------------------------------------------------
# mNotify SMS — powers the RSVP confirmation text (functions/api/rsvp.ts).
#
# Server-side only, same rule as SMTP: no VITE_ prefix, ever. A leaked SMS API
# key gets used to drain your credit sending spam.
#
# On Cloudflare Pages set these under Settings > Variables and Secrets as
# *Secrets* (encrypted) — unlike VITE_*, these are read at runtime by the Pages
# Function, so encryption is real protection here.
#
# For local `wrangler pages dev`, put them in .dev.vars (gitignored).
# ---------------------------------------------------------------------------
MNOTIFY_API_KEY="MY_MNOTIFY_API_KEY"
# Sender ID must be registered with mNotify. Max 11 alphanumeric characters.
MNOTIFY_SENDER_ID="KosuaMeko"
# Optional: organiser number that receives a copy of each RSVP. Leave blank to disable.
MNOTIFY_NOTIFY_TO=""
