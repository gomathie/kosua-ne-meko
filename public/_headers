# Security headers for Cloudflare Pages.
# Vite copies public/ into dist/, which is where Pages reads this from.
#
# Deliberately excluded: a blocking Content-Security-Policy. This page loads
# Turnstile, Unsplash images and the QR-code API, and Tailwind injects styles,
# so a wrong CSP would break the live site silently. The report-only policy
# below logs violations to the browser console without blocking anything —
# check it, then promote to a blocking policy once it is clean.

/*
  # The site is never meant to be framed; blocks clickjacking.
  X-Frame-Options: DENY
  # Belt and braces with the above for browsers honouring CSP only.
  Content-Security-Policy: frame-ancestors 'none'
  # Do not let browsers second-guess declared content types.
  X-Content-Type-Options: nosniff
  # Send the origin, never the full path, to third parties.
  Referrer-Policy: strict-origin-when-cross-origin
  # This site needs none of these; deny them by default.
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=(), usb=()
  # One year of HTTPS-only. No `preload` — that flag is hard to undo.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

  # Report-only: observe what a real CSP would block before enforcing one.
  #
  # static.cloudflareinsights.com is the Web Analytics beacon, injected by
  # Cloudflare at the edge rather than by this codebase — it does not appear in
  # the source or the bundle, so only a real browser load reveals the need.
  # blob: covers the RSVP CSV export, which downloads via URL.createObjectURL.
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://static.cloudflareinsights.com; frame-src https://challenges.cloudflare.com; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' blob: https://challenges.cloudflare.com https://cloudflareinsights.com; font-src 'self' data:; base-uri 'self'; form-action 'self'; object-src 'none'

# Hashed build assets are immutable, so they can be cached hard.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The flyer and stall photos change rarely and are not content-hashed, so cache
# them for a day and let a revalidation pick up a replacement.
/logos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/hero-flyer.*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# robots.txt Disallow stops a crawler fetching /adm, but a URL that is merely
# linked can still be indexed without being fetched. This header is what
# actually keeps the portal out of an index, for any crawler that does reach it.
/adm
  X-Robots-Tag: noindex, nofollow
/adm/*
  X-Robots-Tag: noindex, nofollow
/api/*
  X-Robots-Tag: noindex, nofollow
